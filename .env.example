# ADS OS — пример конфигурации.
# Скопировать в .env и заполнить. Реальные значения НИКОГДА не коммитятся (v0.3 §59, §94).
# Production-секреты живут в Secret Manager / Vault / KMS, а не в .env (v0.4 §2.3).

# ─── Общее ────────────────────────────────────────────────────────────────────
APP_ENV=development                      # development | staging | production
# Домен продукта — ai-helper.pro. Локально работаем на localhost, но именно это
# значение задаёт CORS-allowlist, домен cookie и допустимые redirect URI OAuth,
# поэтому маска "*" здесь запрещена (v0.3 §102, §95).
APP_BASE_URL=http://localhost:3000
API_BASE_URL=http://localhost:8000
LOG_LEVEL=info

# ─── База данных (v0.3 §7, §104) ──────────────────────────────────────────────
DATABASE_URL=postgresql://ads_os:change_me@localhost:5432/ads_os
DATABASE_SSL_MODE=prefer                 # в production — require

# ─── Очередь (v0.4 §16: Celery + Redis) ───────────────────────────────────────
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# ─── Object storage (v0.3 §7, §103) ───────────────────────────────────────────
S3_ENDPOINT=http://localhost:9000
S3_REGION=ru-central1
S3_BUCKET=ads-os-local
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# ─── Шифрование токенов at rest (v0.3 §94) ────────────────────────────────────
# Ключ шифрования хранится отдельно от БД. В production — KMS.
TOKEN_ENCRYPTION_KEY=

# ─── AI provider (v0.4 §2.3) ──────────────────────────────────────────────────
# Провайдер ещё не выбран: разработка идёт на детерминированной заглушке.
# Режим SAFE_PUBLIC — сайт, конкуренты, семантика, объявления.
# Режим SENSITIVE — PII и CRM: внешний провайдер по умолчанию ЗАПРЕЩЁН.
AI_PROVIDER=stub                         # stub | <провайдер, когда будет выбран>
AI_SENSITIVE_PROVIDER=none               # none — PII не уходит внешнему провайдеру

# ─── Яндекс Директ (v0.3 §31–33, v0.4 §2.1) ───────────────────────────────────
# До получения production-доступа и прохождения Security Acceptance Criteria (§114)
# используется MockAdPlatformAdapter. Production-токены запрещены (v0.4 §2.1).
AD_PLATFORM_ADAPTER=mock                 # mock | yandex_direct
YANDEX_DIRECT_CLIENT_ID=
YANDEX_DIRECT_CLIENT_SECRET=
YANDEX_DIRECT_API_URL=https://api-sandbox.direct.yandex.com/json/v5

# ─── Яндекс Метрика (v0.3 §35) ────────────────────────────────────────────────
METRICA_ADAPTER=mock                     # mock | yandex_metrica
YANDEX_METRICA_CLIENT_ID=
YANDEX_METRICA_CLIENT_SECRET=

# ─── Wordstat (v0.4 §2.4) ─────────────────────────────────────────────────────
WORDSTAT_ADAPTER=mock                    # mock | yandex_wordstat
WORDSTAT_DAILY_QUOTA=1000

# ─── Каналы: Telegram / MAX (v0.3 §84–85, §96) ────────────────────────────────
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=                 # проверяется на backend (v0.3 §96)
MAX_ENABLED=false
MAX_BOT_TOKEN=
MAX_WEBHOOK_SECRET=

# ─── Краулер (v0.3 §97, v0.4 §20) ─────────────────────────────────────────────
# Краулер работает в отдельном воркере с собственным egress-firewall.
CRAWLER_MAX_PAGES=50
CRAWLER_TIMEOUT_SECONDS=20
CRAWLER_MAX_PAGE_BYTES=5242880
CRAWLER_MAX_REDIRECTS=5
CRAWLER_ALLOW_PRIVATE_NETWORKS=false     # true допустим ТОЛЬКО в изолированных тестах

# ─── Autopilot (v0.4 §10: выключен по умолчанию) ──────────────────────────────
AUTOPILOT_ENABLED=false

# ─── Фронтенд (apps/web) ──────────────────────────────────────────────────────
# Значения с префиксом NEXT_PUBLIC_ попадают в браузерный бандл — секретов
# среди них быть не должно.
NEXT_PUBLIC_API_URL=http://localhost:8000
# Временный контекст демо-стенда, пока не подключена аутентификация (v0.3 §91).
# Значения выдаёт apps/api/scripts/seed_demo.py.
NEXT_PUBLIC_DEMO_ORG_ID=
NEXT_PUBLIC_DEMO_USER_ID=
