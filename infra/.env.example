# Конфигурация стенда. Скопировать в infra/.env на сервере и заполнить.
# Файл .env в git не попадает (v0.3 §94).

DOMAIN=ai-helper.pro

# ─── База данных ──────────────────────────────────────────────────────────────
POSTGRES_USER=ads_os
POSTGRES_PASSWORD=
POSTGRES_DB=ads_os


# ─── Яндекс Директ ────────────────────────────────────────────────────────────
# Схема доступа — представитель: один токен на главный аккаунт, конкретный
# рекламодатель указывается в каждом запросе. Отдельный токен на клиента не нужен.
#
# ВАЖНО: эти значения заполняются здесь, на сервере, и никуда больше не
# передаются. Токен даёт доступ к рекламным бюджетам (v0.3 §94).
YANDEX_DIRECT_LOGIN=audit-karatsapov
YANDEX_DIRECT_TOKEN=
# Песочница изолирована от настоящих данных. Переключается на false только
# после прохождения проверок безопасности (v0.3 §114).
YANDEX_DIRECT_SANDBOX=true

# Какой адаптер работает: mock — заглушка, yandex_direct — настоящая площадка.
AD_PLATFORM_ADAPTER=mock

# Предохранитель поверх адаптера. Отдельная настройка нужна именно потому, что
# «переключить адаптер» и «разрешить трогать чужие рекламные бюджеты» — разные
# решения. Включается один раз и осознанно, после того как пройдёт
#     bash infra/preflight.sh
AD_PLATFORM_LIVE_APPROVED=false

# ─── Яндекс Метрика ───────────────────────────────────────────────────────────
# Отдельный доступ, не приходит вместе с Директом.
YANDEX_METRICA_TOKEN=

# ─── Вход через Яндекс ID ─────────────────────────────────────────────────────
# Приложение регистрируется на https://oauth.yandex.ru/client/new
# Адрес возврата: https://ai-helper.pro/api/v1/auth/callback
# Право: «Доступ к адресу электронной почты».
YANDEX_OAUTH_CLIENT_ID=
YANDEX_OAUTH_CLIENT_SECRET=

# Почта первого владельца. Работает ровно один раз: пока владельца нет, вход с
# этой почтой создаёт его. Дальше участники заводятся изнутри.
BOOTSTRAP_OWNER_EMAIL=

# ─── Нейросеть ────────────────────────────────────────────────────────────────
# Выбран ChatGPT. Нужен ключ API с platform.openai.com — не подписка ChatGPT
# Plus: это разные продукты, и подписка доступа к API не даёт.
#
# Пока ключа нет, оставьте stub: система работает на детерминированной заглушке
# и об этом честно пишет на экране настроек.
AI_PROVIDER=stub
OPENAI_API_KEY=

# Провайдер для запросов с персональными данными. Значение none означает, что
# такого провайдера нет вовсе: система откажет в запросе, а не отправит его
# наружу. Серверы OpenAI за пределами РФ, а по 152-ФЗ персональные данные
# граждан РФ хранятся в России — поэтому здесь остаётся none (v0.4 §2.3).
AI_SENSITIVE_PROVIDER=none
