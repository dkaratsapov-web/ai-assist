# Конфигурация стенда. Скопировать в infra/.env на сервере и заполнить.
# Файл .env в git не попадает (v0.3 §94).

DOMAIN=ai-helper.pro

# ─── Доступ к стенду ──────────────────────────────────────────────────────────
# Стенд закрыт паролем: аутентификация продукта ещё не реализована.
# Хеш получить командой:
#   docker run --rm caddy:2-alpine caddy hash-password --plaintext 'ваш-пароль'
BASIC_AUTH_USER=team
BASIC_AUTH_HASH=

# ─── База данных ──────────────────────────────────────────────────────────────
POSTGRES_USER=ads_os
POSTGRES_PASSWORD=
POSTGRES_DB=ads_os

# ─── Демо-контекст фронтенда ──────────────────────────────────────────────────
# Значения выдаёт скрипт seed_demo.py после первого запуска. Пока не подключена
# аутентификация, фронтенд передаёт контекст организации заголовками.
NEXT_PUBLIC_DEMO_ORG_ID=
NEXT_PUBLIC_DEMO_USER_ID=

# ─── Яндекс Директ ────────────────────────────────────────────────────────────
# Схема доступа — представитель: один токен на главный аккаунт, конкретный
# рекламодатель указывается в каждом запросе. Отдельный токен на клиента не нужен.
#
# ВАЖНО: эти значения заполняются здесь, на сервере, и никуда больше не
# передаются. Токен даёт доступ к рекламным бюджетам (v0.3 §94).
YANDEX_DIRECT_LOGIN=audit-karatsapov
YANDEX_DIRECT_TOKEN=
# Песочница изолирована от настоящих данных. Переключается на false только
# после прохождения проверок безопасности (v0.3 §114).
YANDEX_DIRECT_SANDBOX=true

# ─── Яндекс Метрика ───────────────────────────────────────────────────────────
# Отдельный доступ, не приходит вместе с Директом.
YANDEX_METRICA_TOKEN=
