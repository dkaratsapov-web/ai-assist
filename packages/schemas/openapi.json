      "Availability": {
        "description": "Насколько можно доверять значению.\n\nСовпадает с состояниями карточки KPI в интерфейсе — одно и то же понятие не\nдолжно называться по-разному на разных концах системы.",
        "enum": [
          "available",
          "proxy",
          "unavailable"
        ],
        "title": "Availability",
        "type": "string"
      },
      "EconomicsMode": {
        "description": "Полнота экономики (v0.4 §5).",
        "enum": [
          "complete",
          "limited",
          "insufficient"
        ],
        "title": "EconomicsMode",
        "type": "string"
      },
      "EconomicsRead": {
        "properties": {
          "average_order_value": {
            "anyOf": [
              {
                "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Average Order Value"
          },
          "expected_value": {
            "anyOf": [
              {
                "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Expected Value"
          },
          "lead_to_sale_rate": {
            "anyOf": [
              {
                "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Lead To Sale Rate"
          },
          "main_conversion": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/MainConversion"
              },
              {
                "type": "null"
              }
            ]
          },
          "margin_percent": {
            "anyOf": [
              {
                "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Margin Percent"
          },
          "monthly_budget": {
            "anyOf": [
              {
                "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Monthly Budget"
          },
          "target_cac": {
            "anyOf": [
              {
                "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Target Cac"
          },
          "target_cpl": {
            "anyOf": [
              {
                "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Target Cpl"
