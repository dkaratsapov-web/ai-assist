      "ProjectStatus": {
        "description": "Технический статус проекта.\n\nНамеренно не совпадает один в один с десятишаговым пользовательским\nжизненным циклом (v0.4 §3): интерфейс показывает этап работы, база хранит\nсостояние обработки, и смешивать их не нужно.",
        "enum": [
          "draft",
          "active",
          "paused",
          "archived",
          "error"
        ],
        "title": "ProjectStatus",
        "type": "string"
      },
