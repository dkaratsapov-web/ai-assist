          "target_marketing_share": {
            "anyOf": [
              {
                "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Target Marketing Share"
          },
          "version": {
            "title": "Version",
            "type": "integer"
          }
        },
        "required": [
          "monthly_budget",
          "average_order_value",
          "expected_value",
          "main_conversion",
          "margin_percent",
          "lead_to_sale_rate",
          "target_cac",
          "target_cpl",
          "target_marketing_share",
          "version"
