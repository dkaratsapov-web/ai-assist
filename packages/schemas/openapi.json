          "purchase"
        ],
        "title": "MainConversion",
        "type": "string"
      },
      "MetricRead": {
        "description": "Значение метрики вместе с оценкой достоверности.\n\nСостояния совпадают с состояниями карточки KPI в интерфейсе: одно и то же\nпонятие не должно называться по-разному на разных концах системы.",
        "properties": {
          "availability": {
            "$ref": "#/components/schemas/Availability"
          },
          "reason": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Что заполнить, чтобы значение стало достоверным",
            "title": "Reason"
          },
          "value": {
            "anyOf": [
              {
                "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Value"
          }
        },
        "required": [
          "value",
          "availability"
        ],
        "title": "MetricRead",
        "type": "object"
      },
