{
  "name": "ads-os",
  "private": true,
  "version": "0.0.0",
  "description": "ADS OS — мультиканальная операционная система для специалиста по контекстной рекламе",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "tokens": "pnpm --filter @ads-os/tokens build",
    "dev": "pnpm tokens && pnpm --filter @ads-os/web dev",
    "build": "pnpm tokens && pnpm --filter @ads-os/web build",
    "start": "pnpm --filter @ads-os/web start",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm -r lint",
    "format": "prettier --write \"**/*.{ts,tsx,js,json,md,css}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,json,md,css}\"",
    "storybook": "pnpm tokens && pnpm --filter @ads-os/web storybook",
    "build-storybook": "pnpm tokens && pnpm --filter @ads-os/web build-storybook",
    "codegen": "python3 -c \"import subprocess;subprocess.run(['.venv/bin/python','apps/api/scripts/export_openapi.py'],check=True)\" && pnpm --filter @ads-os/schemas generate",
    "check:contract": "bash scripts/check-openapi-drift.sh",
    "api:dev": ".venv/bin/uvicorn ads_os.main:app --app-dir apps/api/src --reload --port 8000",
    "api:test": ".venv/bin/python -m pytest apps/api/tests -q",
    "api:migrate": "cd apps/api && ../../.venv/bin/alembic upgrade head"
  },
  "devDependencies": {
    "playwright": "^1.62.1",
    "prettier": "^3.6.2",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "typescript": "^5.9.3"
  }
}
