{
  "name": "@ads-os/schemas",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Типы и клиент API, генерируемые из OpenAPI (v0.4 §18)",
  "exports": {
    ".": "./src/index.ts",
    "./openapi": "./src/openapi.d.ts"
  },
  "types": "./src/index.ts",
  "scripts": {
    "generate": "openapi-typescript ./openapi.json -o ./src/openapi.d.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "devDependencies": {
    "openapi-typescript": "^7.13.0",
    "typescript": "^5.9.3"
  }
}
