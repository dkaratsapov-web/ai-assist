  "info": {
    "description": "Backend ADS OS. Схемы этого API — источник правды для контракта: типы фронтенда генерируются из OpenAPI (v0.4 §18).",
    "title": "ADS OS API",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/v1/health": {
      "get": {
        "description": "Возвращает состояние и режим работы.\n\nПровайдер AI и адаптер площадки показаны намеренно: по ответу должно быть\nсразу видно, работает ли стенд на заглушках. Иначе легко принять\nсгенерированный заглушкой результат за вывод настоящей модели.",
        "operationId": "health_api_v1_health_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Состояние сервиса",
        "tags": [
          "service"
        ]
      }
    },
    "/api/v1/projects": {
      "get": {
        "operationId": "list_projects_api_v1_projects_get",
        "parameters": [
          {
            "in": "query",
            "name": "limit",
